# SQLite file, resolved relative to prisma/schema.prisma.
# For Postgres, change the provider in prisma/schema.prisma and use a postgres URL.
DATABASE_URL="file:./dev.db"

# Local preview password. Change this before any public host.
ADMIN_PASSWORD="local-desk"

# At least 16 characters. Used to sign the desk cookie.
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"

# Canonical origin for metadata, sitemap, and JSON-LD.
# Set this to the host you actually serve. Do not point it at a live domain
# you are not ready to publish, and do not change production DNS from this app.
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:43123"

# Optional. When unset, "Generate profile" uses the built-in template.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Optional email. All three must be set or the desk logs a stub and does not send.
RESEND_API_KEY=""
NOTIFY_EMAIL=""
NOTIFY_FROM=""
