# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local

# local database and private uploads
/storage
/public/media
/prisma/*.db
/prisma/*.db-journal
/prisma/prisma/
/brand-sites/
/.tmp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Swyft International preview (separate app)
swyftinternational/node_modules
swyftinternational/.next
swyftinternational/.data
swyftinternational/test-results

# cloudflare local state and secrets
.wrangler/
.dev.vars
