# Local preview only. Copy to .env. Do not put live secrets here.

# SQLite file for this preview. Production target is Cloudflare D1 (see d1/0001_init.sql).
DATABASE_PATH=".data/swyft.db"

# Local stand-in for the R2 bucket SWYFT_MEDIA.
MEDIA_PATH=".data/objects"

# Desk login. Password is hashed on boot. Change both before any public host.
ADMIN_EMAIL="desk@swyftinternational.example"
ADMIN_PASSWORD="local-desk"
ADMIN_SESSION_SECRET="preview-only-change-this-secret"

# Library login for a placed hire or recruiter. Admin can also open the library.
LIBRARY_EMAIL="library@swyftinternational.example"
LIBRARY_PASSWORD="local-library"

# Commercial terms. Colin can change these without a code edit.
SUCCESS_FEE_PERCENT="33"
SEARCH_DEPOSIT_CENTS="50000"
REPLACEMENT_GUARANTEE_DAYS="90"

# Canonical origin for this preview. Do not point this at a domain you are
# about to attach, and do not change DNS from this app.
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:43124"

# Stripe Checkout, test mode only. Live keys (sk_live_) are refused.
# Leave blank to record a preview hold that does not call Stripe and does not charge.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Token of the fictional sample shortlist seeded for the homepage.
SAMPLE_SHORTLIST_TOKEN="harbor-demo"
